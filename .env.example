AMAZON_RECSYS_BLAIR_MAX_SEQ_LENGTH=256
AMAZON_RECSYS_BLAIR_PROJECTION_DIM=256
AMAZON_RECSYS_BLAIR_ANN_TREES=10
AMAZON_RECSYS_BLAIR_CHUNK_ROWS=25000
AMAZON_RECSYS_MIN_FREE_DISK_GB=40
AMAZON_RECSYS_RETRIEVAL_TOP_K=50
AMAZON_RECSYS_CANDIDATE_UNION_TOP_K=75
AMAZON_RECSYS_CANDIDATE_UNION_BATCH_SIZE=100
AMAZON_RECSYS_COOCCURRENCE_CANDIDATE_K=50
AMAZON_RECSYS_LATENT_CF_CANDIDATE_K=50
AMAZON_RECSYS_CONTENT_CANDIDATE_K=50
AMAZON_RECSYS_NEURAL_CANDIDATE_K=50
