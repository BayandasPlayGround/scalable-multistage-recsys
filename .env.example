# Copy to .env for persistent local overrides.
# Leave advanced training, BLAIR, ranker, monitoring threshold, and Azure knobs out of
# .env unless you intentionally want to override profile defaults.

# Runtime
AMAZON_RECSYS_ENVIRONMENT=local
AMAZON_RECSYS_DEBUG=true
AMAZON_RECSYS_LOG_LEVEL=INFO
AMAZON_RECSYS_HOST=0.0.0.0
AMAZON_RECSYS_PORT=8000
AMAZON_RECSYS_USE_MOCK_BUNDLE_IF_MISSING=true

# Paths
AMAZON_RECSYS_DATA_DIR=amazon_review_data
AMAZON_RECSYS_ARTIFACT_ROOT=artifacts/amazon_recsys
AMAZON_RECSYS_ACTIVE_BUNDLE_PATH=artifacts/production/active_bundle.json

# Training
AMAZON_RECSYS_RUN_PROFILE=debug
AMAZON_RECSYS_CATEGORIES=["All_Beauty","Automotive","Industrial_and_Scientific"]
AMAZON_RECSYS_DEV_MODE=false
AMAZON_RECSYS_DEV_FRACTION=0.2
AMAZON_RECSYS_K_CORE=2
AMAZON_RECSYS_ENABLE_NEURAL_RETRIEVER=false

# Optional integrations
AMAZON_RECSYS_MLFLOW_ENABLED=false
AMAZON_RECSYS_MONITORING_ENABLED=false
