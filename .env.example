AMAZON_RECSYS_APP_NAME=Amazon RecSys Platform
AMAZON_RECSYS_APP_VERSION=0.1.0
AMAZON_RECSYS_ENVIRONMENT=local
AMAZON_RECSYS_DEBUG=true
AMAZON_RECSYS_WORKSPACE_ROOT=.
AMAZON_RECSYS_HOST=0.0.0.0
AMAZON_RECSYS_PORT=8000
AMAZON_RECSYS_RELOAD=false
AMAZON_RECSYS_LOG_LEVEL=INFO
AMAZON_RECSYS_DATA_DIR=amazon_review_data
AMAZON_RECSYS_ARTIFACT_ROOT=artifacts/amazon_recsys
AMAZON_RECSYS_ACTIVE_BUNDLE_PATH=artifacts/production/active_bundle.json
AMAZON_RECSYS_DEFAULT_TOP_K=7
AMAZON_RECSYS_USE_MOCK_BUNDLE_IF_MISSING=true
AMAZON_RECSYS_MLFLOW_ENABLED=true
AMAZON_RECSYS_MLFLOW_TRACKING_URI=
AMAZON_RECSYS_MLFLOW_EXPERIMENT_NAME=amazon-recsys-local
AMAZON_RECSYS_MLFLOW_BACKEND_ROOT=mlflow_runs
AMAZON_RECSYS_MLFLOW_RUN_NAME_PREFIX=
AMAZON_RECSYS_RUN_NAME=default
AMAZON_RECSYS_RUN_PROFILE=debug
AMAZON_RECSYS_SEED=42
AMAZON_RECSYS_K_CORE=2
AMAZON_RECSYS_DEV_MODE=false
AMAZON_RECSYS_DEV_FRACTION=0.2
AMAZON_RECSYS_SHOW_PROGRESS=false
AMAZON_RECSYS_METADATA_DOWNLOAD_IF_MISSING=true
AMAZON_RECSYS_EVAL_USER_CAP=250
AMAZON_RECSYS_ENABLE_NEURAL_RETRIEVER=false
AMAZON_RECSYS_RETRIEVAL_TOP_K=50
AMAZON_RECSYS_CANDIDATE_UNION_TOP_K=75
AMAZON_RECSYS_CANDIDATE_UNION_BATCH_SIZE=100
AMAZON_RECSYS_COOCCURRENCE_CANDIDATE_K=50
AMAZON_RECSYS_LATENT_CF_CANDIDATE_K=50
AMAZON_RECSYS_CONTENT_CANDIDATE_K=50
AMAZON_RECSYS_NEURAL_CANDIDATE_K=50
AMAZON_RECSYS_RANKER_BACKEND=xgboost
AMAZON_RECSYS_RANKER_CANDIDATE_TOP_K=25
AMAZON_RECSYS_RANKER_TRAIN_EXAMPLE_CAP=1000
AMAZON_RECSYS_RANKER_VAL_EXAMPLE_CAP=250
AMAZON_RECSYS_RANKER_NEGATIVES_PER_POSITIVE=5
AMAZON_RECSYS_XGB_LEARNING_RATE=0.05
AMAZON_RECSYS_XGB_N_ESTIMATORS=100
AMAZON_RECSYS_XGB_MAX_DEPTH=6
AMAZON_RECSYS_XGB_SUBSAMPLE=0.8
AMAZON_RECSYS_XGB_COLSAMPLE_BYTREE=0.8
AMAZON_RECSYS_AZURE_SUBSCRIPTION_ID=
AMAZON_RECSYS_AZURE_RESOURCE_GROUP=rg-amazon-recsys
AMAZON_RECSYS_AZURE_LOCATION=southafricanorth
AMAZON_RECSYS_AZURE_ML_WORKSPACE=aml-amazon-recsys
AMAZON_RECSYS_AZURE_AKS_CLUSTER=aks-amazon-recsys
